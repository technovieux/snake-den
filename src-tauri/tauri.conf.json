{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SnakeDen",
  "version": "0.1.0",
  "identifier": "com.snakeden.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SnakeDen",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png"],
    "targets": ["deb"],
    "shortDescription": "Modern virtual machine manager",
    "longDescription": "SnakeDen - launch operating systems like applications.",
    "linux": {
      "deb": {
        "depends": [
          "qemu-system-x86",
          "qemu-utils",
          "quickemu"
        ]
      }
    }
  }
}
